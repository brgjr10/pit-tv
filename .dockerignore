# Git
.git
.gitignore

# User data (large, personal, regenerated)
# The live catalog.json / shows.json are gitignored and are supplied by mounting
# ./data; the image bakes in the tracked data/catalog.demo.json instead, so a
# clean clone builds.
data/*.backup.json
data/catalog.concerts.json
data/*.tmp
data/catalog.json
data/shows.json
videos/
# ~30 MB of personal album art and a stray covers/albums/Thumbs.db would
# otherwise be baked into an image layer that can never be cleaned.
covers/

# Test and QA artifacts
.qa-tmp/
node_modules/

# Local secrets. The Dockerfile copies named paths rather than the repo root, so
# a root .env is not copied today; this keeps that true if a COPY . . is ever added.
.env
.env.*
!.env.example

# Playwright MCP artifacts
.playwright-mcp/

# Editor/OS noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Source photos for the icons (only the derived PNGs ship)
IMG_*.png

# Documentation (not needed in container)
README.md
QA_REPORT.md
e2e_test.md
instructions.md
new.md

# Docker config (not needed in container)
Dockerfile
docker-compose.yml
.dockerignore

# Kilo agent config
.kilo/
