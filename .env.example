# Copy to .env and fill in. Never commit .env - it is gitignored, and the blanked
# copy of this file is the tracked one.

# Port the static server listens on.
PORT=3000

# Interface to bind. Keep 127.0.0.1 for local-only use. The container needs
# 0.0.0.0 to be reachable from outside, which is why PITTV_TOKEN matters there.
HOST=127.0.0.1

# Shared secret required by every mutating route (catalog edits, uploads, the
# video library). Unset means this port can rewrite the catalog for anyone who
# can reach it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PITTV_TOKEN=

# Set to 0 to refuse all writes regardless of PITTV_TOKEN. Writes are enabled
# by default so a local checkout works with no configuration.
PITTV_WRITE=1

# Upload ceilings, in megabytes. The defaults are deliberately high because the
# library holds whole video files.
PITTV_MAX_UPLOAD_MB=40960
PITTV_MAX_JSON_MB=4