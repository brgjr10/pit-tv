# Local video files are large and may be copyrighted.
videos/*
!videos/README.md

# User data: catalog and shows JSON are personal / regenerated.
# The demo catalog (catalog.demo.json) is committed so the repo is usable.
data/catalog.json
data/shows.json
data/*.backup.json
data/catalog.concerts.json
data/*.tmp
# tools/atomic-json.mjs writes a temp file per write, named .tmp-<hex>-<ts>.json,
# and renames it over the target on success. A failed rename (e.g. EPERM over
# SMB) leaves the temp behind, so ignore the exact names the tool produces.
data/.tmp-*.json

# Playwright MCP debug artifacts (logs, screenshots, page snapshots)
.playwright-mcp/

# Cover art - personal images / regenerated placeholders
covers/

# Original photos the Home Screen icons were generated from. Only the
# derived apple-touch-icon.png / assets/icons/*.png are tracked.
IMG_*.png

# Docker CLI config (NOT the Dockerfile or .dockerignore)
.docker/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Bug testing artifacts
e2e_test.md
QA_REPORT.md
instructions.md

# Kilo agent config
.kilo/
